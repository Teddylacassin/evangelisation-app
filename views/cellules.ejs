<%- include('partials/header', { title: 'Cellules de maison' }) %>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

<div class="page-head">
  <h1>🏠 Cellules de maison</h1>
</div>

<% if (typeof rapportOk !== 'undefined' && rapportOk) { %>
  <div class="panel" style="background:#eafaf0; border:1px solid #2f6b4f; padding:12px 16px; margin-bottom:20px;">
    ✅ Merci, ton compte-rendu a bien été enregistré !
  </div>
<% } %>
<% if (typeof rapportErreur !== 'undefined' && rapportErreur) { %>
  <div class="panel" style="background:#fdecea; border:1px solid #c0392b; padding:12px 16px; margin-bottom:20px;">
    ⚠️ Mot de passe incorrect — le compte-rendu n'a pas été enregistré.
  </div>
<% } %>

<section class="panel">
  <p style="margin:0;">Une cellule de maison, c'est un petit groupe qui se retrouve chaque semaine chez quelqu'un, pour partager un moment convivial, lire la Bible et prier ensemble. Trouve celle la plus proche de chez toi et prends contact directement avec le pilote — il te donnera l'adresse une fois que vous serez en contact.</p>
</section>

<section class="panel">
  <form method="GET" action="/cellules" class="form-row" style="align-items:flex-end;">
    <label>Filtrer par quartier
      <select name="quartier" onchange="this.form.submit()">
        <option value="">Tous les quartiers</option>
        <% neighborhoods.forEach(function(n) { %>
          <option value="<%= n.neighborhood %>" <%= selected === n.neighborhood ? 'selected' : '' %>><%= n.neighborhood %></option>
        <% }) %>
      </select>
    </label>
    <% if (selected) { %><a class="btn btn-small" href="/cellules">Réinitialiser</a><% } %>
  </form>
</section>

<% if (cells.length > 0) { %>
<section class="panel">
  <h2>🗺️ Carte des cellules</h2>
  <p class="muted">Position approximative par quartier uniquement — jamais l'adresse exacte, communiquée seulement par le pilote une fois en contact.</p>
  <div id="cells-map" style="height:400px; border-radius:12px; margin-top:12px;"></div>
</section>
<% } %>

<% if (cells.length === 0) { %>
  <p class="empty">Aucune cellule disponible pour l'instant<% if (selected) { %> dans ce quartier<% } %>. Reviens un peu plus tard, ou essaie un autre quartier !</p>
<% } else { %>
<div class="soul-cards">
  <% cells.forEach(function(c) { %>
    <% const pilotDigits = (c.pilot_phone || '').replace(/[^\d+]/g, '').replace('+', ''); %>
    <% const copilotDigits = (c.copilot_phone || '').replace(/[^\d+]/g, '').replace('+', ''); %>
    <div class="soul-card" id="cellule-<%= c.id %>">
      <div class="soul-card-top">
        <span class="status-pill" style="background:var(--primary);">📍 <%= c.neighborhood %></span>
      </div>
      <div class="soul-card-name"><%= c.name %></div>
      <% if (c.meeting_day || c.meeting_time) { %>
        <div class="soul-card-meta">🗓️ <%= c.meeting_day %><% if (c.meeting_day && c.meeting_time) { %>, <% } %><%= c.meeting_time %></div>
      <% } %>
      <% if (c.description) { %><p class="muted" style="margin:4px 0;"><%= c.description %></p><% } %>
      <div class="send-actions" style="margin-top:8px;">
        <a class="btn btn-whatsapp btn-small" target="_blank" href="https://wa.me/<%= pilotDigits %>?text=<%= encodeURIComponent('Bonjour ' + c.pilot_name + ', j\'ai vu la cellule ' + c.name + ' sur la page des cellules de maison et ça m\'intéresse !') %>">💬 Contacter le pilote</a>
        <% if (c.copilot_name && copilotDigits) { %>
          <a class="btn btn-small" target="_blank" href="https://wa.me/<%= copilotDigits %>?text=<%= encodeURIComponent('Bonjour ' + c.copilot_name + ', j\'ai vu la cellule ' + c.name + ' sur la page des cellules de maison et ça m\'intéresse !') %>">💬 Co-pilote</a>
        <% } %>
      </div>

      <% if (currentUser) { %>
        <% if (c.participantCount > 0) { %>
          <p class="muted" style="margin:10px 0 0; font-size:0.85rem;">🙋 <%= c.participantCount %> membre<%= c.participantCount !== 1 ? 's' : '' %> de l'équipe <%= c.participantCount !== 1 ? 'font' : 'fait' %> partie de cette cellule</p>
        <% } %>
        <% if (c.lastReport) { %>
          <p class="muted" style="margin:6px 0 0; font-size:0.85rem;">📋 Dernier compte-rendu<% if (c.lastReport.reporter_name) { %> (<%= c.lastReport.reporter_name %>)<% } %> : <% if (c.lastReport.attendance_count != null) { %><%= c.lastReport.attendance_count %> présent<%= c.lastReport.attendance_count !== 1 ? 's' : '' %> · <% } %><%= c.lastReport.meeting_date %><% if (c.lastReport.note) { %> — <%= c.lastReport.note %><% } %></p>
        <% } %>

        <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:10px;">
          <form method="POST" action="/cellules/<%= c.id %>/participer">
            <input type="hidden" name="return_quartier" value="<%= selected %>">
            <button class="btn btn-small <%= c.iParticipate ? 'btn-active' : 'btn-primary' %>" type="submit"><%= c.iParticipate ? '✓ Je fais partie de cette cellule' : 'Je fais partie de cette cellule' %></button>
          </form>
        </div>
      <% } %>

      <details style="margin-top:10px;">
        <summary class="btn btn-small" style="display:inline-block; cursor:pointer;">📋 Ajouter un compte-rendu</summary>
        <form method="POST" action="/cellules/<%= c.id %>/rapport" class="stacked-form" style="margin-top:10px;">
          <input type="hidden" name="return_quartier" value="<%= selected %>">
          <div class="form-row">
            <label>Date de la rencontre
              <input type="date" name="meeting_date" value="<%= new Date().toISOString().slice(0,10) %>">
            </label>
            <label>Nombre de présents
              <input type="number" name="attendance_count" min="0" placeholder="Ex : 8">
            </label>
          </div>
          <label>Ton nom
            <input type="text" name="reporter_name" placeholder="Ex : Marie Dupont" required>
          </label>
          <label>Note (optionnel)
            <textarea name="note" rows="2" placeholder="Ex : beau temps de partage, une personne est venue pour la première fois"></textarea>
          </label>
          <label>Mot de passe
            <input type="password" name="rapport_password" required>
          </label>
          <button class="btn btn-small btn-primary" type="submit">Envoyer le compte-rendu</button>
        </form>
      </details>
    </div>
  <% }) %>
</div>
<% } %>

<% if (cells.length > 0) { %>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
  (function () {
    var map = L.map('cells-map').setView([50.6326, 5.5797], 12);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(map);

    var points = <%- JSON.stringify(mapPoints) %>;
    points.forEach(function (p) {
      L.circleMarker([p.lat, p.lng], {
        radius: 10,
        color: '#6c5ce7',
        fillColor: '#6c5ce7',
        fillOpacity: 0.8,
        weight: 2
      }).addTo(map).bindPopup(p.label);
    });
    if (points.length > 0) {
      var bounds = L.latLngBounds(points.map(function (p) { return [p.lat, p.lng]; }));
      map.fitBounds(bounds.pad(0.25), { maxZoom: 15 });
    }
  })();
</script>
<% } %>

<%- include('partials/footer') %>

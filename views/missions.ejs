<%- include('partials/header', { title: 'Carte des missions' }) %>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

<div class="page-head">
  <h1>🗺️ Carte des missions</h1>
</div>

<div class="stat-card highlight" style="max-width:360px; margin-bottom:20px;">
  <div class="stat-value">🟢 <span id="active-count"><%= activeCheckins.length %></span></div>
  <div class="stat-label">missionnaire<%= activeCheckins.length !== 1 ? 's' : '' %> actuellement à Liège</div>
</div>

<% if (myActiveCheckin) { %>
  <div class="panel" style="background:#fdecea; border:1px solid #c0392b; padding:12px 16px; margin-bottom:20px; display:flex; align-items:center; gap:10px;">
    <span style="font-size:1.3rem;">📍</span>
    <span style="color:#8a2e24;">Ta position est actuellement visible <strong>en direct</strong> par toute l'équipe, tant que tu restes déclaré sur le terrain. Clique sur « Je quitte le terrain » pour arrêter le partage.</span>
  </div>
<% } %>

<section class="panel">
  <h2>🗺️ Carte en direct</h2>
  <p class="muted">Quand tu es sur le terrain, ta position GPS exacte est partagée en direct avec l'équipe tant que tu restes déclaré — elle disparaît dès que tu quittes le terrain. Les sorties prévues restent affichées par quartier, sans adresse exacte. 🔴 = position en direct · 🟡 = quartier déclaré · 🟢 = sortie prévue.</p>
  <div id="mission-map" style="height:560px; border-radius:12px; margin-top:12px;"></div>
</section>

<section class="panel">
  <h2>🔥 Sur le terrain maintenant</h2>
  <% if (activeCheckins.length === 0) { %>
    <p class="empty">Personne n'est déclaré sur le terrain pour l'instant.</p>
  <% } else { %>
    <ul class="soul-mini-list">
      <% activeCheckins.forEach(function(c) { %>
        <li>
          <span class="status-pill" style="background:var(--gold);">🔥 <%= c.user_name %></span>
          <span class="muted">— <%= c.neighborhood %></span>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <form method="POST" action="/missions/terrain" class="stacked-form" style="margin-top:16px;">
    <% if (myActiveCheckin) { %>
      <p class="muted" style="margin:0;">Tu es déclaré sur le terrain à <strong><%= myActiveCheckin.neighborhood %></strong> depuis <%= myActiveCheckin.started_at %>.</p>
      <button class="btn btn-danger" type="submit">Je quitte le terrain</button>
    <% } else { %>
      <label>Dans quel quartier évangélises-tu ?
        <select name="neighborhood" required>
          <option value="">— Choisis ton quartier —</option>
          <% LIEGE_QUARTIERS.forEach(function(q) { %>
            <option value="<%= q.label %>"><%= q.label %></option>
          <% }) %>
        </select>
      </label>
      <p class="muted" style="font-size:0.85rem; margin:4px 0 0;">En te déclarant sur le terrain, ta position GPS exacte sera partagée en direct avec l'équipe (si tu acceptes la demande de localisation de ton téléphone) tant que tu restes déclaré.</p>
      <button class="btn btn-active" type="submit">🔥 Je suis sur le terrain</button>
    <% } %>
  </form>
</section>

<section class="panel">
  <h2>🏠 Cellules qui se réunissent aujourd'hui (<%= todayName %>)</h2>
  <% if (cellsToday.length === 0) { %>
    <p class="empty">Aucune cellule ne se réunit aujourd'hui.</p>
  <% } else { %>
    <ul class="message-history">
      <% cellsToday.forEach(function(c) { %>
        <li>
          <div class="message-meta">📍 <%= c.neighborhood %><% if (c.meeting_time) { %> · <%= c.meeting_time %><% } %></div>
          <div class="message-content"><strong><%= c.name %></strong><% if (c.description) { %> — <%= c.description %><% } %></div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<section class="panel">
  <h2>📅 Sorties d'évangélisation prévues</h2>

  <form method="POST" action="/missions/sorties" class="stacked-form">
    <div class="form-row">
      <label>Date
        <input type="date" name="outing_date" required>
      </label>
      <label>Quartier
        <select name="neighborhood">
          <option value="">— Choisis un quartier —</option>
          <% LIEGE_QUARTIERS.forEach(function(q) { %>
            <option value="<%= q.label %>"><%= q.label %></option>
          <% }) %>
        </select>
      </label>
    </div>
    <label>Lieu précis
      <input type="text" name="location" placeholder="Ex : Place Saint-Lambert" required>
    </label>
    <label>Notes (optionnel)
      <textarea name="notes" rows="2" placeholder="Ex : RDV 9h30 devant la fontaine"></textarea>
    </label>
    <button class="btn btn-primary" type="submit">Programmer la sortie</button>
  </form>

  <% if (outings.length === 0) { %>
    <p class="empty" style="margin-top:16px;">Aucune sortie programmée pour l'instant.</p>
  <% } else { %>
    <ul class="message-history" style="margin-top:16px;">
      <% outings.forEach(function(o) { %>
        <li>
          <div class="message-meta">
            <%= o.outing_date %> · 📍 <%= o.location %><% if (o.neighborhood) { %> (<%= o.neighborhood %>)<% } %> · <%= o.participants.length %> participant<%= o.participants.length !== 1 ? 's' : '' %>
          </div>
          <div class="message-content">
            <% if (o.notes) { %><%= o.notes %><br><% } %>
            <span class="muted">Programmée par <%= o.creator_name %></span>
            <% if (o.participants.length > 0) { %>
              <br><span class="muted">Participants : <%= o.participants.map(function(p) { return p.user_name; }).join(', ') %></span>
            <% } %>
          </div>
          <div style="display:flex; gap:8px; margin-top:8px;">
            <form method="POST" action="/missions/sorties/<%= o.id %>/participer">
              <button class="btn btn-small <%= o.iParticipate ? 'btn-active' : 'btn-primary' %>" type="submit"><%= o.iParticipate ? '✓ Je participe' : 'Je participe' %></button>
            </form>
            <% if (o.created_by === currentUser.id) { %>
              <form method="POST" action="/missions/sorties/<%= o.id %>/supprimer" onsubmit="return confirm('Supprimer cette sortie programmée ?');">
                <button class="btn btn-small btn-danger" type="submit">Supprimer</button>
              </form>
            <% } %>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
  (function () {
    var map = L.map('mission-map').setView([50.6326, 5.5797], 12);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(map);

    var markers = L.layerGroup().addTo(map);
    var counterEl = document.getElementById('active-count');

    function colorFor(p) {
      if (p.type === 'sortie') return '#2f6b4f';
      return p.live ? '#c0392b' : '#d4a53c';
    }

    function drawPoints(points) {
      markers.clearLayers();
      points.forEach(function (p) {
        var color = colorFor(p);
        L.circleMarker([p.lat, p.lng], {
          radius: p.live ? 11 : 10,
          color: color,
          fillColor: color,
          fillOpacity: 0.8,
          weight: p.live ? 3 : 2
        }).addTo(markers).bindPopup(p.label);
      });
      if (points.length > 0) {
        var bounds = L.latLngBounds(points.map(function (p) { return [p.lat, p.lng]; }));
        map.fitBounds(bounds.pad(0.25), { maxZoom: 15 });
      }
    }

    drawPoints(<%- JSON.stringify(mapPoints) %>);

    // Rafraichit la carte et le compteur toutes les 12 secondes pour voir les
    // positions en direct des autres missionnaires evoluer, sans recharger la page.
    function refreshLive() {
      fetch('/missions/live.json')
        .then(function (r) { return r.json(); })
        .then(function (data) {
          drawPoints(data.mapPoints);
          if (counterEl) counterEl.textContent = data.activeCount;
        })
        .catch(function () {});
    }
    setInterval(refreshLive, 12000);

    <% if (myActiveCheckin) { %>
    // Je suis declare sur le terrain : je partage ma position GPS exacte en direct
    // tant que je reste sur cette page et declare, pour que l'equipe puisse me situer.
    if (navigator.geolocation) {
      function sharePosition() {
        navigator.geolocation.getCurrentPosition(
          function (pos) {
            fetch('/missions/position', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ lat: pos.coords.latitude, lng: pos.coords.longitude })
            }).catch(function () {});
          },
          function () { /* permission refusee : on retombe simplement sur le quartier declare */ },
          { enableHighAccuracy: true, maximumAge: 30000, timeout: 10000 }
        );
      }
      sharePosition();
      setInterval(sharePosition, 15000);
    }
    <% } %>
  })();
</script>

<%- include('partials/footer') %>

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' — Semeurs' : 'Semeurs — Évangélisation' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#2f6b4f">
  <link rel="apple-touch-icon" href="/icon-192.png">
  <link rel="icon" href="/icon-192.png">
  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function () {
        navigator.serviceWorker.register('/sw.js').catch(function () {});
      });
    }
  </script>
</head>
<body>
<% if (currentUser) { %>
<header class="topbar">
  <a class="brand" href="/dashboard">🌾 Semeurs</a>
  <nav class="nav">
    <a href="/dashboard">Tableau de bord</a>
    <a href="/ames">Mes âmes</a>
    <a href="/priere">Espace prière</a>
    <% if (isAdmin) { %><a href="/admin">Administration</a><% } %>
  </nav>
  <div class="user-menu">
    <span class="user-name"><%= currentUser.name %></span>
    <form method="POST" action="/deconnexion" style="display:inline">
      <button class="link-btn" type="submit">Déconnexion</button>
    </form>
  </div>
</header>
<% } %>
<main class="container">

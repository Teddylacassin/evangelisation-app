<%- include('partials/header', { title: 'Nouveau mot de passe' }) %>

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-logo">🌾</div>

    <% if (done) { %>
      <h1>C'est fait ✅</h1>
      <p class="auth-subtitle">Ton mot de passe a bien été changé.</p>
      <p class="auth-switch"><a href="/connexion">Se connecter</a></p>
    <% } else if (!valid) { %>
      <h1>Lien expiré</h1>
      <p class="auth-subtitle">Ce lien n'est plus valable (il a peut-être déjà été utilisé, ou il a plus d'une heure). Demandes-en un nouveau.</p>
      <p class="auth-switch"><a href="/mot-de-passe-oublie">Recevoir un nouveau lien</a></p>
    <% } else { %>
      <h1>Choisir un nouveau mot de passe</h1>
      <% if (error) { %><p class="error"><%= error %></p><% } %>
      <form method="POST" action="/reinitialiser/<%= token %>" class="stacked-form">
        <label>Nouveau mot de passe
          <input type="password" name="password" required minlength="4" autofocus>
        </label>
        <button class="btn btn-primary" type="submit">Enregistrer</button>
      </form>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>

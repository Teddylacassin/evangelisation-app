<%- include('partials/header', { title: 'Mot de passe oublié' }) %>

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-logo">🌾</div>
    <h1>Mot de passe oublié</h1>

    <% if (sent) { %>
      <p class="auth-subtitle">Si un compte existe avec cet email, un lien pour choisir un nouveau mot de passe vient de t'être envoyé. Pense à vérifier tes spams.</p>
      <p class="auth-switch"><a href="/connexion">Retour à la connexion</a></p>
    <% } else { %>
      <p class="auth-subtitle">Indique ton email, on t'envoie un lien pour réinitialiser ton mot de passe.</p>
      <form method="POST" action="/mot-de-passe-oublie" class="stacked-form">
        <label>Email
          <input type="email" name="email" required autofocus>
        </label>
        <button class="btn btn-primary" type="submit">Envoyer le lien</button>
      </form>
      <p class="auth-switch"><a href="/connexion">Retour à la connexion</a></p>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>

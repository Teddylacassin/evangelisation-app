<%- include('partials/header', { title: 'Rapports de sortie' }) %>

<div class="page-head">
  <h1>📋 Rapports de sortie</h1>
</div>

<section class="panel">
  <h2>Rédiger un rapport</h2>
  <form method="POST" action="/rapports" class="stacked-form" id="report-form">
    <div class="form-row">
      <label>Date de la sortie
        <input type="date" name="report_date" value="<%= new Date().toISOString().slice(0,10) %>">
      </label>
      <label>Lieu
        <input type="text" name="location" placeholder="Ex : Place Jean Jaurès, Commune Herstal">
      </label>
    </div>
    <label>Présence (qui était de la sortie)
      <input type="text" name="presence" placeholder="Ex : Saint-Esprit + Gabriel, Teddy et Dan">
    </label>

    <h3 class="cat-title">Personnes rencontrées</h3>
    <div id="people-rows"></div>
    <button type="button" class="btn btn-small" id="add-person">+ Ajouter une personne rencontrée</button>

    <button class="btn btn-primary" type="submit" style="margin-top:14px;">Publier le rapport</button>
  </form>
</section>

<section class="prayer-wall">
  <% if (reports.length === 0) { %>
    <p class="empty">Aucun rapport pour l'instant. Sois le premier à partager ta sortie !</p>
  <% } %>
  <% reports.forEach(function(r) { %>
    <% const savedCount = r.people ? r.people.filter(function(p){ return p.saved; }).length : 0; %>
    <details class="prayer-card">
      <summary style="cursor:pointer; font-weight:600; list-style:revert;">
        Rapport du <%= r.report_date.split('-').reverse().join('/') %>
        <span class="muted" style="font-weight:normal;">
          <% if (r.location) { %>— <%= r.location %><% } %>
          · <%= r.user_name %>
          <% if (savedCount > 0) { %> · <span class="badge-answered" style="font-weight:normal;">🙌 <%= savedCount %></span><% } %>
        </span>
      </summary>
      <div style="margin-top:12px;">
        <% if (r.presence) { %><p class="muted" style="margin:0 0 10px;">Présence : <%= r.presence %></p><% } %>
        <% if (r.people && r.people.length > 0) { %>
          <ul class="message-history" style="gap:2px;">
            <% r.people.forEach(function(p) { %>
              <li style="padding:6px 0; border-bottom:1px solid var(--border);">
                <div class="message-content" style="margin-top:0; white-space:normal;">📍 <strong><%= p.name %></strong><% if (p.saved) { %> <span class="badge-answered">Sauvé(e) 🙌</span><% } %><% if (p.soul_id) { %> <a href="/ames/<%= p.soul_id %>">voir sa fiche</a><% } %><% if (p.notes) { %> — <%= p.notes %><% } %><div class="muted" style="font-size:0.78rem; margin-top:2px;">Évangélisé(e) : <%= p.evangelized ? 1 : 0 %> · Sauvé(e) : <%= p.saved ? 1 : 0 %> · Tel : <%= p.phone || '0' %> · Invité(e) : <%= p.invited_church ? 1 : 0 %></div></div>
              </li>
            <% }) %>
          </ul>
        <% } %>
        <% if (r.user_id === currentUser.id) { %>
          <form method="POST" action="/rapports/<%= r.id %>/supprimer" onsubmit="return confirm('Supprimer ce rapport ?');" style="margin-top:8px;">
            <button class="btn btn-small btn-danger" type="submit">Supprimer</button>
          </form>
        <% } %>
      </div>
    </details>
  <% }) %>
</section>

<script>
  let personIndex = 0;
  const rowsContainer = document.getElementById('people-rows');

  function addPersonRow() {
    const idx = personIndex++;
    const div = document.createElement('div');
    div.className = 'panel';
    div.style.marginBottom = '12px';
    div.innerHTML = `
      <div class="form-row">
        <label>Nom
          <input type="text" name="person[${idx}][name]">
        </label>
        <label>Téléphone
          <input type="tel" name="person[${idx}][phone]" placeholder="Optionnel">
        </label>
      </div>
      <label>Récit
        <textarea name="person[${idx}][notes]" rows="2" placeholder="Contexte de la rencontre..."></textarea>
      </label>
      <div class="form-row">
        <label style="flex-direction:row; align-items:center; gap:8px;">
          <input type="checkbox" name="person[${idx}][evangelized]" value="1" style="width:auto;"> Évangélisé(e)
        </label>
        <label style="flex-direction:row; align-items:center; gap:8px;">
          <input type="checkbox" name="person[${idx}][saved]" value="1" style="width:auto;"> Sauvé(e)
        </label>
        <label style="flex-direction:row; align-items:center; gap:8px;">
          <input type="checkbox" name="person[${idx}][invited]" value="1" style="width:auto;"> Invité(e) à l'église
        </label>
      </div>
      <button type="button" class="btn btn-small btn-danger remove-person">Retirer cette personne</button>
    `;
    div.querySelector('.remove-person').addEventListener('click', function () {
      div.remove();
    });
    rowsContainer.appendChild(div);
  }

  addPersonRow();
  document.getElementById('add-person').addEventListener('click', addPersonRow);
</script>

<%- include('partials/footer') %>

<%- include('partials/header', { title: 'Tableau de bord' }) %>

<div class="page-head">
  <h1>Bonjour <%= currentUser.name.split(' ')[0] %> 👋</h1>
  <a href="/ames/nouvelle" class="btn btn-primary">+ Ajouter une âme rencontrée</a>
</div>

<% if (announcements.length > 0) { %>
  <section class="announcement-banner">
    <% announcements.forEach(function(a) { %>
      <div class="announcement-item">
        <span class="announcement-icon">📣</span>
        <div>
          <p class="announcement-content"><%= a.content %></p>
          <span class="announcement-meta"><%= a.author_name %> — <%= a.created_at %></span>
        </div>
      </div>
    <% }) %>
  </section>
<% } %>

<section class="stat-grid">
  <div class="stat-card highlight">
    <div class="stat-value"><%= total %></div>
    <div class="stat-label">Âmes gagnées au total</div>
  </div>
  <div class="stat-card">
    <div class="stat-value"><%= thisWeek %></div>
    <div class="stat-label">Cette semaine</div>
  </div>
  <div class="stat-card">
    <div class="stat-value"><%= thisMonth %></div>
    <div class="stat-label">Ces 30 derniers jours</div>
  </div>
  <div class="stat-card">
    <div class="stat-value"><%= teamTotal %></div>
    <div class="stat-label">Âmes gagnées par toute l'équipe</div>
  </div>
  <% if (prayerSupportCount > 0) { %>
    <div class="stat-card" style="grid-column: 1 / -1;">
      <div class="stat-value">🙏 <%= prayerSupportCount %></div>
      <div class="stat-label">Fois où l'équipe a prié pour tes sujets de prière</div>
    </div>
  <% } %>
</section>

<div class="two-col">
  <section class="panel">
    <h2>🎯 Mes objectifs</h2>
    <% if (goals.length === 0) { %>
      <p class="empty">Aucun objectif défini pour l'instant.</p>
      <a class="btn btn-small" href="/objectifs">Définir un objectif</a>
    <% } else { %>
      <% goals.forEach(function(g) { %>
        <div style="margin-bottom:12px;">
          <div style="display:flex; justify-content:space-between; font-size:0.9rem;">
            <span><%= GOAL_METRICS[g.metric] %> · <%= GOAL_PERIODS[g.period_type].label %></span>
            <strong><%= g.achieved %> / <%= g.target %></strong>
          </div>
          <div style="background:var(--border); border-radius:999px; height:8px; margin-top:4px; overflow:hidden;">
            <div style="background:var(--primary); height:100%; width:<%= g.percent %>%;"></div>
          </div>
        </div>
      <% }) %>
      <a class="btn btn-small" href="/objectifs" style="margin-top:4px;">Gérer mes objectifs</a>
    <% } %>
  </section>

  <section class="panel">
    <h2>Mes âmes récentes</h2>
    <% if (recentSouls.length === 0) { %>
      <p class="empty">Aucune âme enregistrée pour l'instant.</p>
    <% } else { %>
      <ul class="soul-mini-list">
        <% recentSouls.forEach(function(s) { %>
          <li>
            <a href="/ames/<%= s.id %>"><%= s.name %></a>
            <span class="muted"><%= STATUSES[s.status].label %></span>
          </li>
        <% }) %>
      </ul>
    <% } %>
    <a class="btn btn-small" href="/ames" style="margin-top:8px;">Voir toutes mes âmes</a>
  </section>
</div>

<section class="panel">
  <h2>Répartition par statut</h2>
  <div class="status-bars">
    <% Object.keys(STATUSES).forEach(function(s) { %>
      <div class="status-row">
        <span class="status-dot" style="background:<%= STATUSES[s].color %>"></span>
        <span class="status-name"><%= STATUSES[s].label %></span>
        <span class="status-count"><%= statusCounts[s] %></span>
      </div>
    <% }) %>
  </div>
</section>

<div class="two-col">
  <section class="panel">
    <h2>À recontacter</h2>
    <p class="muted">Âmes sans nouvelles depuis plus de 7 jours</p>
    <% if (aRecontacter.length === 0) { %>
      <p class="empty">Tu es à jour, rien à recontacter pour l'instant 🎉</p>
    <% } else { %>
      <ul class="soul-mini-list">
        <% aRecontacter.forEach(function(s) { %>
          <li>
            <a href="/ames/<%= s.id %>"><%= s.name %></a>
            <span class="muted"><%= s.city || '' %></span>
            <a class="btn btn-small" href="/ames/<%= s.id %>/message">Envoyer un verset</a>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section class="panel">
    <h2>Classement de l'équipe</h2>
    <ol class="ranking">
      <% teamRanking.forEach(function(r) { %>
        <li><span><%= r.name %></span><strong><%= r.c %></strong></li>
      <% }) %>
    </ol>
  </section>
</div>

<%- include('partials/footer') %>

<%- include('partials/header', { title: 'Administration' }) %>

<div class="page-head">
  <h1>📣 Administration — Annonces</h1>
</div>

<% if (pendingUsers.length > 0) { %>
<section class="panel" style="border:1px solid #f59e0b;">
  <h2>⏳ Comptes en attente de validation (<%= pendingUsers.length %>)</h2>
  <p class="muted">Tant qu'un compte n'est pas validé, la personne ne peut pas se connecter ni voir les données des âmes.</p>
  <ul class="message-history">
    <% pendingUsers.forEach(function(u) { %>
      <li>
        <div class="message-meta"><%= u.created_at %></div>
        <div class="message-content">
          <strong><%= u.name %></strong> — <%= u.email %><% if (u.church) { %> · <%= u.church %><% } %>
        </div>
        <div style="display:flex; gap:8px; margin-top:8px;">
          <form method="POST" action="/admin/utilisateurs/<%= u.id %>/valider">
            <button class="btn btn-small btn-active" type="submit">✓ Valider</button>
          </form>
          <form method="POST" action="/admin/utilisateurs/<%= u.id %>/refuser" onsubmit="return confirm('Refuser et supprimer cette demande de compte ?');">
            <button class="btn btn-small btn-danger" type="submit">Refuser</button>
          </form>
        </div>
      </li>
    <% }) %>
  </ul>
</section>
<% } %>

<section class="panel">
  <h2>Envoyer une annonce à toute l'équipe</h2>
  <p class="muted">Le message apparaîtra en haut du tableau de bord de chaque gagneur d'âme.</p>
  <form method="POST" action="/admin/annonces" class="stacked-form">
    <textarea name="content" rows="3" placeholder="Ex : Bravo à tous pour cette semaine, continuons à semer ! Rendez-vous samedi 10h pour la sortie d'évangélisation." required></textarea>
    <button class="btn btn-primary" type="submit">Publier l'annonce</button>
  </form>
</section>

<section class="panel">
  <h2>🎥 Salle Zoom de la réunion de prière</h2>
  <p class="muted">Le lien fixe de votre réunion récurrente (même lien à chaque fois). S'affiche en haut de l'espace prière.</p>
  <form method="POST" action="/admin/zoom" class="stacked-form">
    <div class="form-row">
      <label>Quand ?
        <input type="text" name="zoom_label" value="<%= zoomLabel || '' %>" placeholder="Ex : Tous les mercredis à 20h">
      </label>
      <label>Lien Zoom
        <input type="url" name="zoom_link" value="<%= zoomLink || '' %>" placeholder="https://zoom.us/j/...">
      </label>
    </div>
    <button class="btn btn-primary" type="submit">Mettre à jour</button>
  </form>
</section>

<section class="panel">
  <h2>📅 Programmer les leads de prière</h2>
  <p class="muted">Programme à l'avance qui va leader et co-leader chaque réunion. L'espace prière affiche automatiquement la prochaine à venir.</p>
  <form method="POST" action="/admin/reunions-priere" class="stacked-form">
    <div class="form-row">
      <label>Date
        <input type="date" name="meeting_date" required>
      </label>
      <label>Sujet de la prière
        <input type="text" name="topic" placeholder="Ex : Prions pour les âmes rencontrées ce mois-ci">
      </label>
    </div>
    <div class="form-row">
      <label>Lead
        <select name="lead_id">
          <option value="">— Aucun —</option>
          <% teamMembers.forEach(function(m) { %>
            <option value="<%= m.id %>"><%= m.name %></option>
          <% }) %>
        </select>
      </label>
      <label>Co-lead
        <select name="colead_id">
          <option value="">— Aucun —</option>
          <% teamMembers.forEach(function(m) { %>
            <option value="<%= m.id %>"><%= m.name %></option>
          <% }) %>
        </select>
      </label>
    </div>
    <button class="btn btn-primary" type="submit">Programmer</button>
  </form>

  <% if (prayerMeetings.length === 0) { %>
    <p class="empty" style="margin-top:16px;">Aucune réunion programmée pour l'instant.</p>
  <% } else { %>
    <ul class="message-history" style="margin-top:16px;">
      <% prayerMeetings.forEach(function(m) { %>
        <li>
          <div class="message-meta"><%= m.meeting_date %></div>
          <div class="message-content">
            <% if (m.topic) { %><strong><%= m.topic %></strong><br><% } %>
            Lead : <%= m.lead_name || '—' %> · Co-lead : <%= m.colead_name || '—' %>
          </div>
          <form method="POST" action="/admin/reunions-priere/<%= m.id %>/supprimer" onsubmit="return confirm('Supprimer cette réunion programmée ?');" style="margin-top:8px;">
            <button class="btn btn-small btn-danger" type="submit">Supprimer</button>
          </form>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<section class="panel">
  <h2>🏠 Cellules de maison</h2>
  <p class="muted">Ces cellules apparaissent sur la page publique <code>/cellules</code> — celle vers laquelle pointe le QR code de vos cartes d'invitation. Seuls le quartier et les contacts WhatsApp du pilote / co-pilote sont visibles publiquement, jamais l'adresse.</p>
  <form method="POST" action="/admin/cellules" class="stacked-form">
    <div class="form-row">
      <label>Nom de la cellule
        <input type="text" name="name" placeholder="Ex : Cellule Outremeuse" required>
      </label>
      <label>Quartier
        <input type="text" name="neighborhood" placeholder="Ex : Outremeuse, Liège" required>
      </label>
    </div>
    <div class="form-row">
      <label>Jour
        <input type="text" name="meeting_day" placeholder="Ex : Mercredi">
      </label>
      <label>Heure
        <input type="text" name="meeting_time" placeholder="Ex : 19h30">
      </label>
    </div>
    <label>Description courte
      <textarea name="description" rows="2" placeholder="Ex : Une ambiance conviviale, ouverte à tous, en français."></textarea>
    </label>
    <div class="form-row">
      <label>Nom du pilote
        <input type="text" name="pilot_name" required>
      </label>
      <label>Téléphone du pilote (WhatsApp)
        <input type="tel" name="pilot_phone" placeholder="+32 4XX XX XX XX" required>
      </label>
    </div>
    <div class="form-row">
      <label>Nom du co-pilote (optionnel)
        <input type="text" name="copilot_name">
      </label>
      <label>Téléphone du co-pilote (optionnel)
        <input type="tel" name="copilot_phone" placeholder="+32 4XX XX XX XX">
      </label>
    </div>
    <button class="btn btn-primary" type="submit">Ajouter la cellule</button>
  </form>

  <% if (houseCells.length === 0) { %>
    <p class="empty" style="margin-top:16px;">Aucune cellule de maison enregistrée pour l'instant.</p>
  <% } else { %>
    <ul class="message-history" style="margin-top:16px;">
      <% houseCells.forEach(function(c) { %>
        <li>
          <div class="message-meta">
            <%= c.neighborhood %><% if (c.meeting_day) { %> · <%= c.meeting_day %><% } %><% if (c.meeting_time) { %> <%= c.meeting_time %><% } %>
            <% if (!c.active) { %> · <span style="color:var(--danger); font-weight:700;">Fermée</span><% } %>
          </div>
          <div class="message-content">
            <strong><%= c.name %></strong> — Pilote : <%= c.pilot_name %> (<%= c.pilot_phone %>)<% if (c.copilot_name) { %> · Co-pilote : <%= c.copilot_name %> (<%= c.copilot_phone %>)<% } %>
          </div>
          <div style="display:flex; gap:8px; margin-top:8px;">
            <form method="POST" action="/admin/cellules/<%= c.id %>/toggle">
              <button class="btn btn-small" type="submit"><%= c.active ? 'Fermer temporairement' : 'Réouvrir' %></button>
            </form>
            <form method="POST" action="/admin/cellules/<%= c.id %>/supprimer" onsubmit="return confirm('Supprimer définitivement cette cellule ?');">
              <button class="btn btn-small btn-danger" type="submit">Supprimer</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<section class="panel">
  <h2>🔑 Mot de passe des comptes-rendus de cellules</h2>
  <p class="muted">Un pilote de cellule (même sans compte sur l'appli) peut poster un compte-rendu après une rencontre depuis la page publique <code>/cellules</code>, à condition de connaître ce mot de passe. Communique-le uniquement aux personnes de confiance.</p>
  <form method="POST" action="/admin/cellules-mot-de-passe" class="stacked-form">
    <label>Mot de passe
      <input type="text" name="cellule_rapport_password" value="<%= cellulePassword || '' %>" placeholder="Ex : semeurs2026">
    </label>
    <button class="btn btn-primary" type="submit">Enregistrer</button>
  </form>
</section>

<section class="panel">
  <h2>Annonces publiées</h2>
  <% if (announcements.length === 0) { %>
    <p class="empty">Aucune annonce publiée pour l'instant.</p>
  <% } else { %>
    <ul class="message-history">
      <% announcements.forEach(function(a) { %>
        <li>
          <div class="message-meta"><%= a.author_name %> — <%= a.created_at %></div>
          <div class="message-content"><%= a.content %></div>
          <form method="POST" action="/admin/annonces/<%= a.id %>/supprimer" onsubmit="return confirm('Supprimer cette annonce ?');" style="margin-top:8px;">
            <button class="btn btn-small btn-danger" type="submit">Supprimer</button>
          </form>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<%- include('partials/footer') %>
